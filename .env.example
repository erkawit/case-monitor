# รหัสผ่านเข้าระบบ (บังคับ) — ตั้งให้ยาวและเดายาก
APP_PASSWORD=

# (ไม่บังคับ) คีย์ลงลายมือชื่อคุกกี้ — ถ้าไม่ตั้งจะสร้างจาก APP_PASSWORD
AUTH_SECRET=

# Upstash Redis — ได้อัตโนมัติเมื่อเชื่อม Upstash จาก Vercel Marketplace
KV_REST_API_URL=
KV_REST_API_TOKEN=

# (ไม่บังคับ) อายุการเข้าสู่ระบบ (ชั่วโมง) ค่าเริ่มต้น 12
SESSION_HOURS=12
